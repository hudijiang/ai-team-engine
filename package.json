{
  "name": "ai-team-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-specifier-resolution=node --test tests/*.test.mjs",
    "test:coverage:ceo": "node --experimental-test-coverage --test-coverage-include=src/engine/ceoAgent.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --experimental-specifier-resolution=node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gateway": "node gateway/server.mjs",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "framer-motion": "^12.34.3",
    "marked": "^17.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.2",
    "zustand": "^5.0.11"
  }
}
